# Used by docker-compose.yml for local development. Copy to .env in this
# same directory (repo root) before running `docker compose up`.
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=replace_with_a_long_random_string
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
SIMILARITY_THRESHOLD=0.3
LOG_LEVEL=info

# Worker Architecture:
# - true (default): Runs BullMQ workers inside the API server process (zero extra hosting cost on Railway/Render).
# - false: Disables in-process workers, allowing workers to run in a separate standalone process via `npm run worker`.
RUN_WORKERS_IN_PROCESS=true
