# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas free-tier connection string (Phase 2: user accounts + cloud storage).
# Create a free cluster at https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_study_assistant

# Long, random secret used to sign login tokens (openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string

# Port for the backend server
PORT=5000

# Comma-separated allowed origin(s) for CORS (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Minimum cosine similarity for a retrieved chunk to be trusted for an answer
# (below this, chat says "couldn't find this" instead of guessing). Optional —
# defaults to 0.3 if unset. See vectorStore.js for tuning guidance.
SIMILARITY_THRESHOLD=0.3

# Log verbosity for the structured logger (pino). One of: fatal, error, warn,
# info, debug, trace. Optional — defaults to "info".
LOG_LEVEL=info
