{
  "name": "ai-study-assistant-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "Backend for AI Study Assistant — auth, cloud storage, PDF upload, RAG chat, summaries, flashcards, quizzes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node workers/index.js",
    "worker:watch": "node --watch workers/index.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --experimental-test-module-mocks --test test/integration/"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^0.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.1.3",
    "pino": "^9.3.2",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0"
  }
}